generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")

}

enum SourceType {
  SEED
  RSS
  GDELT
  YOUTUBE
  OPENALEX
  GITHUB
  MANUAL_SOCIAL
  SUBMISSION
  WEB
}

enum RelevanceStatus {
  PENDING
  ACCEPTED
  REJECTED
  UNCERTAIN
}

enum ReviewStatus {
  QUEUED
  FETCHING
  ANALYZED
  NEEDS_REVIEW
  APPROVED
  REJECTED
  FAILED
}

enum UserRole {
  USER
  RESEARCHER
  ADMIN
}

enum PullStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED_MISSING_KEY
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  name            String?
  role            UserRole        @default(USER)
  submissions     SubmittedData[]
  companyAccount  CompanyAccount?
  companyMemberships CompanyMembership[]
  companySubmissions CompanySubmission[]
  companyReviews CompanyReview[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model SourceRecord {
  id                  String                  @id @default(cuid())
  sourceType          SourceType
  title               String
  url                 String                  @unique
  excerpt             String                  @default("")
  publishedAt         DateTime?
  author              String?
  platform            String?
  rawMeta             Json                    @default("{}")
  relevanceStatus     RelevanceStatus         @default(PENDING)
  relevanceReason     String?
  relevanceConfidence Float                   @default(0)
  annotations         PerspectiveAnnotation[]
  triplets            Triplet[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([sourceType])
  @@index([relevanceStatus])
  @@index([publishedAt])
}

model RobotModel {
  id                String         @id @default(cuid())
  canonicalName     String         @unique
  manufacturer      String?
  developerOrg      String?
  countryOfOrigin   String?
  robotType         String         @default("unknown")
  embodimentLevel   String?
  primaryUseCase    String?
  thailandStatus    String         @default("observed_in_thailand")
  statusConfidence  Float          @default(0.5)
  officialUrl       String?
  description       String?
  sourceMeta        Json           @default("{}")
  firstSeenYear     Int?
  lastVerifiedAt    DateTime?
  contributions     Contribution[]
  inventory         OwnedInventory[]
  companyLinks      CompanyRobot[]
  companyProposals  CompanySubmission[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([robotType])
  @@index([thailandStatus])
}

model Entity {
  id           String   @id @default(cuid())
  name         String
  entityType   String
  canonicalKey String   @unique
  sourceMeta   Json     @default("{}")
  createdAt    DateTime @default(now())
  company      Company?

  @@index([entityType])
}

model Contribution {
  id                  String      @id @default(cuid())
  contributorName     String?
  contributorType     String?
  organization        String?
  contributionType    String
  title               String
  description         String?
  relatedRobotModelId String?
  relatedRobotModel   RobotModel? @relation(fields: [relatedRobotModelId], references: [id], onDelete: SetNull)
  sourceUrl           String?     @unique
  license             String?
  visibility          String      @default("public")
  verificationStatus  ReviewStatus @default(NEEDS_REVIEW)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([contributionType])
  @@index([verificationStatus])
}

model PerspectiveAnnotation {
  id                String       @id @default(cuid())
  sourceId          String
  source            SourceRecord @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  stance            String       @default("unclear")
  sentiment         String       @default("unclear")
  perspectiveTheme  String       @default("unclear")
  targetEntity      String       @default("humanoid/social robotics")
  evidenceExcerpt   String       @default("")
  confidence        Float        @default(0.5)
  method            String
  createdAt         DateTime     @default(now())

  @@unique([sourceId, perspectiveTheme, targetEntity, evidenceExcerpt])
  @@index([perspectiveTheme])
}

model Triplet {
  id         String        @id @default(cuid())
  subject    String
  relation   String
  object     String
  confidence Float         @default(0.5)
  sourceId   String?
  source     SourceRecord? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())

  @@unique([subject, relation, object, sourceId])
  @@index([relation])
}

model StatsCache {
  key       String   @id
  valueJson Json
  updatedAt DateTime @updatedAt
}

model SubmittedData {
  id               String       @id @default(cuid())
  submissionType   String
  title            String
  url              String?
  payloadJson      Json         @default("{}")
  notes            String?
  submitterName    String?
  submitterContact String?
  status           ReviewStatus @default(QUEUED)
  reviewNotes      String?
  submittedById    String?
  submittedBy      User?        @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status])
  @@index([submissionType])
}

model LivingLabPlan {
  id                 String                   @id @default(cuid())
  ownerTokenHash     String
  title              String
  objective          String                   @default("")
  steps              String                   @default("")
  question           String
  role               String                   @default("general")
  participantGroup   String                   @default("")
  participantCount   String                   @default("")
  siteContext        String                   @default("")
  activityGoal       String                   @default("")
  sessionLength      String                   @default("")
  staffing           String                   @default("")
  readinessNotes     String                   @default("")
  evidence           Json                     @default("[]")
  evidenceSnapshotAt DateTime                 @default(now())
  revisions          LivingLabPlanRevision[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([ownerTokenHash, updatedAt])
}

model LivingLabPlanRevision {
  id         String       @id @default(cuid())
  planId     String
  plan       LivingLabPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  snapshot   Json
  feedback   String       @default("")
  createdAt  DateTime     @default(now())

  @@index([planId, createdAt])
}

model PipelineRun {
  id           String     @id @default(cuid())
  pipelineName String
  status       PullStatus
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
  detailsJson  Json       @default("{}")

  @@index([pipelineName])
  @@index([status])
}

model SourcePullJob {
  id           String     @id @default(cuid())
  adapter      SourceType
  query        String
  status       PullStatus @default(QUEUED)
  recordsFound Int        @default(0)
  recordsSaved Int        @default(0)
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([adapter])
  @@index([status])
}

model ResearchAssistantFeedback {
  id                 String   @id @default(cuid())
  vote               String
  questionCategory   String
  expertRole         String?
  robotId            String?
  externalSearchUsed Boolean  @default(false)
  issueCategory      String?
  comment            String?
  createdAt          DateTime @default(now())

  @@index([createdAt])
  @@index([robotId, createdAt])
}

model OwnedInventory {
  id                 String      @id @default(cuid())
  robotModelId       String?
  robotModel         RobotModel? @relation(fields: [robotModelId], references: [id], onDelete: SetNull)
  displayName        String
  ownershipStatus    String
  ownerOrg           String?
  custodian          String?
  locationLabel      String?
  serialNumber       String?
  publicSerialSafe   Boolean     @default(false)
  acquisitionDate    DateTime?
  acquisitionSource  String?
  conditionStatus    String?
  firmwareVersion    String?
  accessories        Json        @default("[]")
  documentationLinks Json        @default("[]")
  visibility         String      @default("private")
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([robotModelId])
}

model CompanyAccount {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  isAdmin Boolean @default(false)
  sessions CompanySession[]
}

model CompanySession {
  tokenHash String @id
  userId String
  account CompanyAccount @relation(fields: [userId], references: [userId], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}

model Company {
  id String @id
  name String
  nameKey String @unique
  website String
  domain String @unique
  published Json?
  revision Int @default(0)
  entityId String? @unique
  entity Entity? @relation(fields: [entityId], references: [id], onDelete: Restrict)
  memberships CompanyMembership[]
  submissions CompanySubmission[]
  robots CompanyRobot[]
  createdAt DateTime @default(now())
}

model CompanyMembership {
  id String @id
  companyId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  status String @default("PENDING_REVIEW")
  businessEmail String
  evidence String
  feedback String @default("")
  version Int @default(1)
  createdAt DateTime @default(now())
  reviews CompanyReview[]
  @@unique([companyId, userId])
}

model CompanySubmission {
  id String @id
  companyId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind String
  status String @default("DRAFT")
  proposed Json
  baseline Json
  targetRobotId String?
  targetRobot RobotModel? @relation(fields: [targetRobotId], references: [id], onDelete: Restrict)
  publicId String?
  version Int @default(1)
  feedback String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  submittedAt DateTime?
  reviews CompanyReview[]
  @@index([companyId, status])
}

model CompanyReview {
  id String @id
  submissionId String?
  submission CompanySubmission? @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  membershipId String?
  membership CompanyMembership? @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  actorId String
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  decision String
  feedback String
  snapshot Json
  createdAt DateTime @default(now())
}

model CompanyRobot {
  companyId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  robotId String @unique
  robot RobotModel @relation(fields: [robotId], references: [id], onDelete: Restrict)
  @@id([companyId, robotId])
}

model CompanyRateLimit {
  key String @id
  attempts Int
  expiresAt DateTime
}

model ResearchAssistantRateLimit {
  keyHash String
  windowStart DateTime @db.Timestamptz(3)
  count Int @default(1)

  @@id([keyHash, windowStart])
  @@index([windowStart])
}
