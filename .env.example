DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
RESEARCH_SEARCH_PROVIDER="public"
# Production uses the shared PostgreSQL limiter; apply migrations first.
RESEARCH_RATE_LIMIT_BACKEND="postgres"
# Set true only behind a trusted proxy that overwrites forwarded headers.
TRUST_PROXY_HEADERS="false"
